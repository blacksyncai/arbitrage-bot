# ── Trading Mode ──────────────────────────────────────────────────────────────
# DRY_RUN=true  → simulate only, no real orders (safe default)
# DRY_RUN=false → place real orders on Polymarket (needs keys below)
DRY_RUN=true

# ── Polymarket Credentials (required for live trading) ────────────────────────
# Get these at: polymarket.com → top-right avatar → API Keys
#
# POLY_PRIVATE_KEY:    your Polygon wallet private key (starts with 0x)
#                      This wallet must hold USDC on Polygon for collateral
# POLY_API_KEY/SECRET/PASSPHRASE: from the Polymarket API Keys page
POLY_PRIVATE_KEY=0x...
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Bot Strategy Parameters (override CLI defaults) ───────────────────────────
# All of these can also be set via CLI flags (run: python bot_runner.py --help)
MAX_ENTRY_PRICE=0.20     # only buy cheap sides ≤ 20¢
TARGET_ROI=0.10          # exit at +10% ROI
STOP_LOSS=0.50           # cut loss at -50%
MAX_POS_USDC=50          # max $ per trade
MAX_POSITIONS=5          # max concurrent trades
MAX_HOLD_MIN=45          # force-exit after 45 minutes
SCAN_INTERVAL=15         # scan every 15 seconds
MIN_MOMENTUM=0.003       # require +0.3¢ upward momentum to enter
MIN_VOLUME=5000          # min market volume in USD

# ── Anthropic (optional — for Claude AI verification in run_bot.py) ───────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Kalshi (for the original arbitrage bot in main.py / run_bot.py) ───────────
KALSHI_API_KEY=
KALSHI_API_SECRET=

# ── Gemini Predictions (for the original arbitrage bot) ──────────────────────
GEMINI_API_KEY=
GEMINI_API_SECRET=
