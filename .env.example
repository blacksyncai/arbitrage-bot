# Copy this file to .env and fill in your API keys
# cp .env.example .env

# Anthropic API key (for Claude opportunity verification)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Polymarket credentials (for live order execution)
# Get yours at: https://polymarket.com -> Settings -> API Keys
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_PRIVATE_KEY=

# Kalshi credentials (for live order execution)
# Get yours at: https://kalshi.com -> Settings -> API
KALSHI_API_KEY=
KALSHI_API_SECRET=

# Gemini credentials (for live order execution)
# Get yours at: https://exchange.gemini.com -> Settings -> API
GEMINI_API_KEY=
GEMINI_API_SECRET=
